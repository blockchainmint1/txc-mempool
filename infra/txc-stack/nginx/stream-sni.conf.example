# Optional: keep electrum*.texitcoin.org:443 working (SNI passthrough)
#
# The TXC Wallet app that is already installed on phones is hard-wired to
# electrum1/2/3.texitcoin.org on port **443**. Our box already uses 443 for the
# HTTPS API, so to serve both on one IP we terminate nothing at 443 and instead
# route by SNI: electrum* hostnames get passed through to the electrum shim,
# everything else goes to the normal HTTPS vhost on 8443.
#
# This means EXISTING app installs keep working with only a DNS change — no app
# store release required.
#
# HOW TO APPLY (see RUNBOOK.md step 5 for the copy/paste version):
#   1. In nginx/nginx.conf change `listen 443 ssl http2;`
#      to `listen 127.0.0.1:8443 ssl http2;` and add `listen 8443 ssl http2;`
#   2. Paste the `stream { ... }` block below into nginx.conf at the TOP LEVEL
#      (a sibling of `http { ... }`, not inside it).
#   3. Publish 443 from the nginx container as usual, and add 50002 too.

stream {
    # Docker's embedded DNS. REQUIRED: nginx resolves a static `upstream
    # { server electrum:50002; }` only once at startup, so it keeps dialling a
    # dead IP after the shim container is recreated and connections hang. A
    # variable proxy_pass target is resolved per connection instead.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # electrum1.texitcoin.org, electrum2..., electrum.texitcoin.org -> shim
    map $ssl_preread_server_name $txc_upstream {
        ~^electrum   electrum:50002;
        default      127.0.0.1:8443;
    }

    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass $txc_upstream;
        proxy_timeout 10m;
        proxy_connect_timeout 5s;
    }
}

